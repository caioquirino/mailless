{
  "name": "@mailless/directory-dynamodb",
  "version": "0.0.1",
  "description": "DynamoDB directory for @mailless/directory",
  "license": "Apache-2.0",
  "keywords": [
    "email",
    "mail",
    "accounts",
    "directory"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "directory-dynamodb",
    "tags": [
      "scope:directory",
      "type:lib",
      "platform:aws"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          {
            "target": "local-services",
            "projects": [
              "@mailless/source"
            ]
          }
        ]
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@mailless/directory": "workspace:*",
    "tslib": "^2.3.0"
  }
}
