{
  "name": "@mailless/transport-ses",
  "version": "0.0.1",
  "description": "Amazon SES mail transport for @mailless/jmap-server",
  "license": "Apache-2.0",
  "keywords": [
    "jmap",
    "email",
    "mail",
    "ses"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "transport-ses",
    "tags": [
      "scope:transport",
      "type:lib",
      "platform:aws"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@mailless/jmap-server": "workspace:*",
    "tslib": "^2.3.0"
  }
}
