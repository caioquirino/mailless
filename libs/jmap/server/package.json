{
  "name": "@mailless/jmap-server",
  "version": "0.0.1",
  "description": "A JMAP server with mail, contacts and sharing: the mailless modules assembled on one engine",
  "license": "Apache-2.0",
  "author": "Caio Quirino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioquirino/mailless.git",
    "directory": "libs/jmap/server"
  },
  "homepage": "https://github.com/caioquirino/mailless/tree/main/libs/jmap/server#readme",
  "bugs": "https://github.com/caioquirino/mailless/issues",
  "keywords": [
    "jmap",
    "email",
    "mail",
    "rfc8620",
    "rfc8621"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "@mailless/source": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./memory": {
      "@mailless/source": "./src/memory.ts",
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./testing": {
      "@mailless/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "jmap-server",
    "tags": [
      "scope:jmap-server",
      "type:lib"
    ]
  },
  "dependencies": {
    "@mailless/jmap-contacts": "workspace:*",
    "@mailless/jmap-core": "workspace:*",
    "@mailless/jmap-engine": "workspace:*",
    "@mailless/jmap-mail": "workspace:*",
    "@mailless/jmap-sharing": "workspace:*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
