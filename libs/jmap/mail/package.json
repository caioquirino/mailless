{
  "name": "@mailless/jmap-mail",
  "version": "0.0.1",
  "description": "Mail for a JMAP server (RFC 8621): mailboxes, emails, threads, sending, vacation response, read receipts, blob management and quota",
  "license": "Apache-2.0",
  "keywords": [
    "jmap",
    "email",
    "mail",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "jmap-mail",
    "tags": [
      "scope:jmap-mail",
      "type:lib"
    ]
  },
  "dependencies": {
    "@mailless/jmap-core": "workspace:*",
    "@mailless/jmap-engine": "workspace:*",
    "postal-mime": "^4.0.4",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  }
}
