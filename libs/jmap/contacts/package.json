{
  "name": "@mailless/jmap-contacts",
  "version": "0.0.1",
  "description": "Contacts for a JMAP server (RFC 9610): address books and JSContact cards",
  "license": "Apache-2.0",
  "author": "Caio Quirino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioquirino/mailless.git",
    "directory": "libs/jmap/contacts"
  },
  "homepage": "https://github.com/caioquirino/mailless/tree/main/libs/jmap/contacts#readme",
  "bugs": "https://github.com/caioquirino/mailless/issues",
  "keywords": [
    "jmap",
    "email",
    "mail",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "jmap-contacts",
    "tags": [
      "scope:jmap-contacts",
      "type:lib"
    ]
  },
  "dependencies": {
    "@mailless/jmap-core": "workspace:*",
    "@mailless/jmap-engine": "workspace:*",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  }
}
