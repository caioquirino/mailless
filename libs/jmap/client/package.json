{
  "name": "@mailless/jmap-client",
  "version": "0.0.1",
  "description": "JMAP client (RFC 8620/8621) for TypeScript: session discovery, batched calls with typed back-references, uploads and downloads",
  "license": "Apache-2.0",
  "author": "Caio Quirino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioquirino/mailless.git",
    "directory": "libs/jmap/client"
  },
  "homepage": "https://github.com/caioquirino/mailless/tree/main/libs/jmap/client#readme",
  "bugs": "https://github.com/caioquirino/mailless/issues",
  "keywords": [
    "jmap",
    "email",
    "mail",
    "client",
    "rfc8620",
    "rfc8621"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "jmap-client",
    "tags": [
      "scope:jmap-client",
      "type:lib"
    ]
  },
  "dependencies": {
    "@mailless/jmap-core": "workspace:*",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@mailless/jmap-server": "workspace:*"
  }
}
