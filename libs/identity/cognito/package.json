{
  "name": "@mailless/identity-cognito",
  "version": "0.0.1",
  "description": "Amazon Cognito identity provider for @mailless/identity",
  "license": "Apache-2.0",
  "author": "Caio Quirino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioquirino/mailless.git",
    "directory": "libs/identity/cognito"
  },
  "homepage": "https://github.com/caioquirino/mailless/tree/main/libs/identity/cognito#readme",
  "bugs": "https://github.com/caioquirino/mailless/issues",
  "keywords": [
    "identity",
    "oidc",
    "authentication"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "identity-cognito",
    "tags": [
      "scope:identity",
      "type:lib",
      "platform:aws"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@mailless/identity": "workspace:*",
    "tslib": "^2.3.0"
  }
}
