{
  "name": "@mailless/identity",
  "version": "0.0.1",
  "description": "Who may sign in: the identity provider behind an interface, and verification of the tokens it issues",
  "license": "Apache-2.0",
  "keywords": [
    "identity",
    "oidc",
    "authentication"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@mailless/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "identity",
    "tags": [
      "scope:identity",
      "type:lib"
    ]
  },
  "dependencies": {
    "aws-jwt-verify": "^5.2.1",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
