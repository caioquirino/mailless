{
  "name": "@mailless/jmap-server",
  "version": "0.0.1",
  "description": "Transport- and storage-agnostic JMAP (RFC 8620/8621) server framework for TypeScript",
  "license": "Apache-2.0",
  "keywords": [
    "jmap",
    "email",
    "mail",
    "rfc8620",
    "rfc8621"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./memory": {
      "@mailless/source": "./src/memory.ts",
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./testing": {
      "@mailless/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "jmap-server",
    "tags": [
      "scope:jmap-server",
      "type:lib"
    ]
  },
  "dependencies": {
    "@mailless/jmap-core": "workspace:*",
    "postal-mime": "^4.0.4",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
