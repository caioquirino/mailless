{
  "name": "@mailless/admin-api",
  "version": "0.0.1",
  "description": "The mailless administration API: accounts, addresses, shares and each user's own credentials",
  "license": "Apache-2.0",
  "keywords": [
    "email",
    "mail",
    "admin",
    "openapi"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "admin-api",
    "tags": [
      "scope:admin",
      "type:lib"
    ],
    "targets": {
      "openapi": {
        "command": "node dist/write-openapi.js && prettier --write openapi.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/openapi.json"
        ],
        "cache": true
      }
    }
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@mailless/directory": "workspace:*",
    "@mailless/identity": "workspace:*",
    "@mailless/jmap-server": "workspace:*",
    "hono": "^4.13.13",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  }
}
