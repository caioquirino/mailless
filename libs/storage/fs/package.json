{
  "name": "@mailless/storage-fs",
  "version": "0.0.1",
  "description": "Filesystem blob store for a mailless JMAP server",
  "license": "Apache-2.0",
  "author": "Caio Quirino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioquirino/mailless.git",
    "directory": "libs/storage/fs"
  },
  "homepage": "https://github.com/caioquirino/mailless/tree/main/libs/storage/fs#readme",
  "bugs": "https://github.com/caioquirino/mailless/issues",
  "keywords": [
    "jmap",
    "email",
    "mail",
    "storage"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mailless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "storage-fs",
    "tags": [
      "scope:storage",
      "type:lib"
    ]
  },
  "dependencies": {
    "@mailless/jmap-engine": "workspace:*",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@mailless/jmap-server": "workspace:*"
  }
}
