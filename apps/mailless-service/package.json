{
  "name": "@mailless/mailless-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "mailless-service",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/mailless-service/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/mailless-service/src/ingest.ts",
          "tsConfig": "apps/mailless-service/tsconfig.build.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".mjs"
            },
            "mainFields": [
              "module",
              "main"
            ],
            "banner": {
              "js": "import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);"
            }
          },
          "thirdParty": true,
          "additionalEntryPoints": [
            "apps/mailless-service/src/api.ts",
            "apps/mailless-service/src/events.ts",
            "apps/mailless-service/src/push.ts",
            "apps/mailless-service/src/send.ts",
            "apps/mailless-service/src/admin.ts",
            "apps/mailless-service/src/admin-api.ts",
            "apps/mailless-service/src/purge.ts",
            "apps/mailless-service/src/webmail.ts"
          ]
        },
        "configurations": {
          "development": {},
          "production": {}
        },
        "dependsOn": [
          "^build",
          "embed-admin-web",
          "embed-webmail"
        ]
      },
      "test": {
        "dependsOn": [
          "^build",
          "build",
          "embed-admin-web",
          "embed-webmail",
          {
            "target": "local-services",
            "projects": [
              "@mailless/source"
            ]
          }
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "embed-admin-web",
          "embed-webmail"
        ]
      },
      "lint": {
        "dependsOn": [
          "embed-admin-web",
          "embed-webmail"
        ]
      },
      "embed-admin-web": {
        "command": "node tools/embed-web.mjs apps/admin-web/dist apps/mailless-service/src/admin/web-assets.gen.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "admin-web"
            ]
          }
        ],
        "inputs": [
          "{workspaceRoot}/tools/embed-web.mjs",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": false
          }
        ],
        "outputs": [
          "{projectRoot}/src/admin/web-assets.gen.ts"
        ],
        "cache": true
      },
      "embed-webmail": {
        "command": "node tools/embed-web.mjs apps/webmail/dist apps/mailless-service/src/webmail/web-assets.gen.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "webmail"
            ]
          }
        ],
        "inputs": [
          "{workspaceRoot}/tools/embed-web.mjs",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": false
          }
        ],
        "outputs": [
          "{projectRoot}/src/webmail/web-assets.gen.ts"
        ],
        "cache": true
      }
    },
    "tags": [
      "type:app"
    ],
    "implicitDependencies": [
      "admin-web",
      "webmail"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-scheduler": "^3.1147.0",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@aws-sdk/client-sqs": "^3.1147.0",
    "@aws-sdk/client-ssm": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@mailless/admin-api": "workspace:*",
    "@mailless/app-passwords": "workspace:*",
    "@mailless/directory": "workspace:*",
    "@mailless/directory-dynamodb": "workspace:*",
    "@mailless/identity": "workspace:*",
    "@mailless/identity-cognito": "workspace:*",
    "@mailless/jmap-core": "workspace:*",
    "@mailless/jmap-server": "workspace:*",
    "@mailless/storage-dynamodb": "workspace:*",
    "@mailless/storage-s3": "workspace:*",
    "@mailless/transport-ses": "workspace:*",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164"
  },
  "type": "module"
}
