# Copy to terraform.tfvars and fill in. terraform.tfvars is not committed.

region = "eu-west-1"
domain = "example.com"

# Accounts, their addresses and who shares what are not set here: the first
# account is made with `pnpm infra admin create <account>`, the rest in the
# admin interface.

# How much mail an account may hold, in bytes. Leave out for no limit.
# account_quota_bytes = 5368709120

# true replaces whatever SES receipt rule set is active in this region today.
activate_receipt_rule_set = false

# Set when the domain's DNS is hosted in Route53; otherwise add the records from
# the dns_records output by hand.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Where the sign-in pages are, with route53_zone_id set. Defaults to
# auth.<domain>; the domain itself must have an A record.
# auth_hostname = "auth.example.com"

# Where other mail services send daily reports about the domain (DMARC and
# TLS). Files for a program to read: give an address kept for them.
# mail_report_address = "reports@example.com"

# What senders are told about TLS, with route53_zone_id set: "enforce" (the
# default), "testing" to only be told what would have been held back, or null.
# mta_sts_mode = "testing"

# For running the admin interface on your own machine against this stack.
# admin_extra_callback_urls = ["http://localhost:5173/admin/callback"]

# For running the webmail on your own machine against this stack.
# webmail_extra_callback_urls = ["http://localhost:5174/mail/callback"]
