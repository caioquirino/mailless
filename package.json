{
  "name": "@mailless/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx run-many -t lint typecheck validate test build",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "dev": "nx serve dev-server",
    "services:up": "nx run @mailless/source:local-services",
    "services:down": "docker compose down",
    "infra": "node tools/infra.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "@eslint/js": "^9.8.0",
    "@nx/esbuild": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.2.1",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "verdaccio": "^6.3.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "local-services": {
        "command": "docker compose up -d && node tools/wait-for-local-services.mjs",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": false
      }
    }
  }
}
