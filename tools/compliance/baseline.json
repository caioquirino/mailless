  "t/Email/foreign-account.t": {
    "status": "fail",
    "failed": [
      "Email/copy fromAccountId=OTHER accountId=SELF: accountNotFound"
    ],
    "note": "The suite expects accountNotFound when the account to copy from is not one the user has. RFC 8620 section 5.4 defines fromAccountNotFound for exactly that, which is what this server answers. (An accountId that is not the user's does get accountNotFound.)"
  },
  "t/Email/query/filtering.t": {
    "status": "fail",
    "failed": [
      "allInThreadHaveKeyword filter, none match that all have",
      "noneInThreadHaveKeyword filter, match, don't get some back",
      "someInThreadHaveKeyword filter, match"
    ],
    "note": "The suite puts replies with a different subject in the thread of the message they answer. RFC 8621 section 3 recommends also requiring the same subject, so that a reply used to start a new conversation gets its own thread; this server follows that."
  },
  "t/Email/set/if-in-state.t": {
    "status": "fail",
    "failed": [
      "got current state"
    ],
    "note": "Not about ifInState: the test checks that the state string is true in Perl, and this server's state before any change is \"0\", which Perl reads as false. RFC 8620 puts no such limit on state strings."
  },
